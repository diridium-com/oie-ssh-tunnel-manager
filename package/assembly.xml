<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0 http://maven.apache.org/xsd/assembly-2.0.0.xsd">
    <id>pack-signed-jars</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <fileSet>
            <directory>${project.build.directory}/to-be-packed</directory>
            <outputDirectory>${packageName}</outputDirectory>
            <!-- Only this plugin's own jars ship. JSch stays provided: the engine
                 already carries it in server-lib. -->
            <includes>
                <include>oie-ssh-tunnel-manager-*.jar</include>
                <include>plugin.xml</include>
            </includes>
        </fileSet>
    </fileSets>
    <!-- Web administrator UI: discovered by the OIE web admin at
         <extensions>/oie-ssh-tunnel-manager/webadmin/plugin.json. plugin.js is
         built from ../webadmin/web/plugin.jsx by the frontend-maven-plugin. -->
    <files>
        <file>
            <source>../webadmin/plugin.json</source>
            <outputDirectory>${packageName}/webadmin</outputDirectory>
        </file>
        <file>
            <source>../webadmin/web/plugin.js</source>
            <outputDirectory>${packageName}/webadmin/web</outputDirectory>
        </file>
    </files>
</assembly>
