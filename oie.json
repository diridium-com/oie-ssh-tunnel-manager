    "maxEngineVersion": null,
    "filename": "oie-ssh-tunnel-manager-{version}.zip",
    "restartRequired": true,
    "homepage": "https://github.com/diridium-com/oie-ssh-tunnel-manager",
    "documentation": "https://github.com/diridium-com/oie-ssh-tunnel-manager#readme",
    "storeDocs": "docs/store.md",
